generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Attire {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(255)
  modelId            Int                 @map("model_id")
  boneId             Int                 @map("bone_id")
  x                  Decimal             @db.Decimal(18, 6)
  y                  Decimal             @db.Decimal(18, 6)
  z                  Decimal             @db.Decimal(18, 6)
  rX                 Decimal             @map("r_x") @db.Decimal(18, 6)
  rY                 Decimal             @map("r_y") @db.Decimal(18, 6)
  rZ                 Decimal             @map("r_z") @db.Decimal(18, 6)
  sX                 Decimal             @map("s_x") @db.Decimal(18, 6)
  sY                 Decimal             @map("s_y") @db.Decimal(18, 6)
  sZ                 Decimal             @map("s_z") @db.Decimal(18, 6)
  type               String              @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  playerPresetItems  PlayerPresetItem[]
  vehiclePresetItems VehiclePresetItem[]

  @@index([deletedAt])
  @@map("attire")
}

model House {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(255)
  description   String?        @db.VarChar(255)
  userId        String?        @map("user_id") @db.Uuid
  isEnabled     Boolean        @default(false) @map("is_enabled")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  sysUser       SysUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  houseModels   HouseModel[]
  race          Race?
  teleport      Teleport?

  @@index([userId])
  @@index([deletedAt])
  @@unique([name])
  @@map("house")
}

model HouseModel {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @db.VarChar(255)
  args      String   @db.VarChar(255)
  houseId   String?  @map("house_id") @db.Uuid
  index     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  house     House?   @relation(fields: [houseId], references: [id], onDelete: SetNull)

  @@unique([houseId, index])
  @@index([houseId])
  @@map("house_model")
}

model Race {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(255)
  description   String?        @db.VarChar(255)
  isEnabled     Boolean        @default(false) @map("is_enabled")
  totalLength   Decimal        @default(0) @db.Decimal(18, 6) @map("total_length")
  laps          Int            @default(1)
  userId        String?        @map("user_id") @db.Uuid
  houseId       String?        @unique @map("house_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  house         House?         @relation(fields: [houseId], references: [id], onDelete: SetNull)
  sysUser       SysUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  raceCps       RaceCp[]
  raceCpScripts RaceCpScript[]
  raceRecords   RaceRecord[]
  raceGroupRaces RaceGroupRace[]

  @@index([userId])
  @@index([deletedAt])
  @@index([name, deletedAt])
  @@map("race")
}

model RaceGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  index     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  races     RaceGroupRace[]

  @@index([deletedAt])
  @@index([index])
  @@map("race_group")
}

model RaceGroupRace {
  raceGroupId String    @map("race_group_id") @db.Uuid
  raceId      String    @map("race_id") @db.Uuid
  index       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  raceGroup   RaceGroup @relation(fields: [raceGroupId], references: [id], onDelete: Cascade)
  race        Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@id([raceGroupId, raceId])
  @@unique([raceGroupId, index])
  @@index([raceGroupId])
  @@index([raceId])
  @@map("race_group_race")
}

model RaceCp {
  id            String         @id @default(uuid()) @db.Uuid
  index         Int
  x             Decimal        @db.Decimal(18, 6)
  y             Decimal        @db.Decimal(18, 6)
  z             Decimal        @db.Decimal(18, 6)
  angle         Decimal        @db.Decimal(18, 6)
  size          Decimal        @db.Decimal(18, 6)
  raceId        String?        @map("race_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  race          Race?          @relation(fields: [raceId], references: [id], onDelete: SetNull)
  raceCpScripts RaceCpScript[]

  @@index([raceId])
  @@unique([raceId, index])
  @@map("race_cp")
}

model RaceCpScript {
  id           String   @id @default(uuid()) @db.Uuid
  script       String   @db.VarChar(255)
  index        Int
  raceId       String?  @map("race_id") @db.Uuid
  checkpointId String?  @map("checkpoint_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  raceCp       RaceCp?  @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  race         Race?    @relation(fields: [raceId], references: [id], onDelete: SetNull)

  @@index([raceId])
  @@index([checkpointId])
  @@map("race_cp_script")
}

model RaceRecord {
  id          String    @id @default(uuid()) @db.Uuid
  record      Int
  userId      String?   @map("user_id") @db.Uuid
  raceId    String?   @map("race_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  race      Race?     @relation(fields: [raceId], references: [id], onDelete: SetNull)
  sysUser   SysUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([raceId])
  @@index([userId])
  @@index([deletedAt])
  @@map("race_record")
}

model SysRole {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique @db.VarChar(255)
  name           String          @db.VarChar(255)
  sort           Int
  isEnabled      Boolean         @map("is_enabled")
  remark         String          @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  sysUserRoles   SysUserRole[]

  @@map("sys_role")
}

model SysUserGameSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  loginAt         DateTime  @default(now()) @map("login_at") @db.Timestamptz(6)
  logoutAt        DateTime? @map("logout_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime  @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  status          String    @default("ONLINE") @db.VarChar(10)
  duration        Int?
  ip              String?   @db.VarChar(45)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sysUser         SysUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, lastHeartbeatAt])
  @@map("sys_user_game_session")
}

model SysUser {
  id                  String               @id @default(uuid()) @db.Uuid
  username            String               @db.VarChar(255)
  password            String               @db.VarChar(255)
  salt                String?              @db.VarChar(255)
  isEnabled           Boolean              @default(true) @map("is_enabled")
  email               String?              @unique @db.VarChar(255)
  emailVerifiedAt     DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  houses              House[]
  races               Race[]
  raceRecords         RaceRecord[]
  sysUserBans         SysUserBan[]
  bannedBans          SysUserBan[]  @relation("BannedBy")
  sysUserRoles        SysUserRole[]
  sysUserSetting      SysUserSetting?
  teleports           Teleport[]
  userVehicles        UserVehicle[]
  playerPresets       PlayerPreset[]
  vehiclePresets      VehiclePreset[]
  gameSessions        SysUserGameSession[]
  replays             Replay[]

  @@unique([username])
  @@index([deletedAt])
  @@map("sys_user")
}

model SysUserBan {
  id         String    @id @default(uuid()) @db.Uuid
  endAt      DateTime? @map("end_at") @db.Timestamptz(6)
  reason     String    @db.VarChar(255)
  userId     String?   @map("user_id") @db.Uuid
  bannedById String?   @map("banned_by_id") @db.Uuid
  ip         String?   @map("ip") @db.VarChar(45)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  sysUser    SysUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  bannedBy   SysUser?  @relation("BannedBy", fields: [bannedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bannedById])
  @@map("sys_user_ban")
}

model SysUserRole {
  sysRoleId String  @map("sys_role_id") @db.Uuid
  sysUserId String  @map("sys_user_id") @db.Uuid
  sysRole   SysRole @relation(fields: [sysRoleId], references: [id], onDelete: Cascade)
  sysUser   SysUser @relation(fields: [sysUserId], references: [id], onDelete: Cascade)

  @@id([sysRoleId, sysUserId])
  @@index([sysRoleId])
  @@index([sysUserId])
  @@map("sys_user_role")
}

model SysUserSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  skinId             Int      @default(0) @map("skin_id")
  timeMinute         Int      @default(0) @map("time_minute")
  timeHour           Int      @default(12) @map("time_hour")
  weather            Int      @default(0)
  prefix             String?  @db.VarChar(255)
  suffix             String?  @db.VarChar(255)
  invincible         Boolean  @default(true) @map("invincible")
  vehicleFlip        Boolean  @default(true) @map("vehicle_flip")
  vehicleAutoFix     Boolean  @default(true) @map("vehicle_auto_fix")
  vehicleNoCollision Boolean  @default(true) @map("vehicle_no_collision")
  showObject         Boolean  @default(true) @map("show_object")
  showSpeed          Boolean  @default(true) @map("show_speed")
  showNetstat        Boolean  @default(true) @map("show_netstat")
  syncGameTime       Boolean  @default(true) @map("sync_game_time")
  showName           Boolean  @default(true) @map("show_name")
  showStunt          Boolean  @default(true) @map("show_stunt")
  nitroType          String   @default("timer") @map("nitro_type") @db.VarChar(10)
  spawnMode          String   @default("RANDOM") @map("spawn_mode") @db.VarChar(16)
  lastX              Decimal? @map("last_x") @db.Decimal(18, 6)
  lastY              Decimal? @map("last_y") @db.Decimal(18, 6)
  lastZ              Decimal? @map("last_z") @db.Decimal(18, 6)
  lastAngle          Decimal? @map("last_angle") @db.Decimal(18, 6)
  showVehicleAttire  Boolean  @default(true) @map("show_vehicle_attire")
  vehicleColorCycle  Boolean  @default(false) @map("vehicle_color_cycle")
  syncWorldWeather   Boolean  @default(true) @map("sync_world_weather")
  timeFlow           Boolean  @default(true) @map("time_flow")
  playerColor        String   @default("#ffffff") @map("player_color") @db.VarChar(9)
  acceptTeleport     Boolean  @default(true) @map("accept_teleport")
  /** 右上角时间 TextDraw 显示（按 syncGameTime/自定义时间推算） */
  showTimeGui        Boolean  @default(true) @map("show_time_gui")
  showPlayerAttire   Boolean  @default(true) @map("show_player_attire")
  sessionType        String   @default("PRIVATE") @map("session_type") @db.VarChar(10)
  sessionPassword    String?  @map("session_password") @db.VarChar(32)
  enterWorldMode     String   @default("PUBLIC") @map("enter_world_mode") @db.VarChar(10)
  hideAllGui         Boolean  @default(false) @map("hide_all_gui")
  showSpeed2d        Boolean  @default(false) @map("show_speed_2d")
  showSpeed3d        Boolean  @default(false) @map("show_speed_3d")
  showDebugInfo      Boolean  @default(false) @map("show_debug_info")
  userId             String?  @unique @map("user_id") @db.Uuid
  defaultPlayerPresetId String? @map("default_player_preset_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  sysUser            SysUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  defaultPlayerPreset PlayerPreset? @relation(fields: [defaultPlayerPresetId], references: [id], onDelete: SetNull)

  @@index([defaultPlayerPresetId])
  @@map("sys_user_setting")
}

model Teleport {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(255)
  x           Decimal   @db.Decimal(18, 6)
  y           Decimal   @db.Decimal(18, 6)
  z           Decimal   @db.Decimal(18, 6)
  angle       Decimal   @db.Decimal(18, 6)
  interiorId  Int       @map("interior_id")
  isSystem    Boolean   @map("is_system")
  isEnabled   Boolean   @map("is_enabled")
  userId      String?   @map("user_id") @db.Uuid
  houseId     String?   @unique @map("house_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  house       House?    @relation(fields: [houseId], references: [id], onDelete: SetNull)
  sysUser     SysUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@unique([name])
  @@index([houseId])
  @@index([deletedAt])
  @@map("teleport")
}

model MapIcon {
  id        String   @id @default(uuid()) @db.Uuid
  iconId    Int      @map("icon_id")
  x         Decimal  @db.Decimal(18, 6)
  y         Decimal  @db.Decimal(18, 6)
  z         Decimal  @db.Decimal(18, 6)
  index     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([deletedAt])
  @@map("map_icon")
}

model UserVehicle {
  id              String              @id @default(uuid()) @db.Uuid
  modelId         Int                 @map("model_id")
  userId          String              @map("user_id") @db.Uuid
  x               Decimal             @db.Decimal(18, 6)
  y               Decimal             @db.Decimal(18, 6)
  z               Decimal             @db.Decimal(18, 6)
  angle           Decimal             @db.Decimal(18, 6)
  isLocked        Boolean             @map("is_locked")
  allowGoto       Boolean             @default(true) @map("allow_goto")
  isDefault       Boolean             @default(false) @map("is_default")
  description     String?             @db.VarChar(255)
  plateNumber     String?             @map("plate_number") @db.VarChar(255)
  defaultPresetId String?             @map("default_preset_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  sysUser         SysUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultPreset   VehiclePreset?      @relation(fields: [defaultPresetId], references: [id], onDelete: SetNull)

  @@index([modelId])
  @@index([userId])
  @@index([defaultPresetId])
  @@index([deletedAt])
  @@unique([userId, modelId])
  @@map("user_vehicle")
}

model PlayerPreset {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  skinId      Int               @default(0) @map("skin_id")
  index       Int               @default(0)
  name        String?           @db.VarChar(255)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
  sysUser     SysUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlayerPresetItem[]
  settings    SysUserSetting[]

  @@unique([userId, skinId, index])
  @@index([userId])
  @@index([deletedAt])
  @@map("player_preset")
}

model PlayerPresetItem {
  id        String        @id @default(uuid()) @db.Uuid
  presetId  String        @map("preset_id") @db.Uuid
  attireId  String        @map("attire_id") @db.Uuid
  boneId    Int           @map("bone_id")
  x         Decimal       @db.Decimal(18, 6)
  y         Decimal       @db.Decimal(18, 6)
  z         Decimal       @db.Decimal(18, 6)
  rX        Decimal       @map("r_x") @db.Decimal(18, 6)
  rY        Decimal       @map("r_y") @db.Decimal(18, 6)
  rZ        Decimal       @map("r_z") @db.Decimal(18, 6)
  sX        Decimal       @map("s_x") @db.Decimal(18, 6)
  sY        Decimal       @map("s_y") @db.Decimal(18, 6)
  sZ        Decimal       @map("s_z") @db.Decimal(18, 6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  preset    PlayerPreset  @relation(fields: [presetId], references: [id], onDelete: Cascade)
  attire    Attire        @relation(fields: [attireId], references: [id], onDelete: Cascade)

  @@unique([presetId, attireId])
  @@index([presetId])
  @@index([attireId])
  @@map("player_preset_item")
}

model VehiclePreset {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  modelId        Int                 @map("model_id")
  index          Int                 @default(0)
  name           String?             @db.VarChar(255)
  color1         Int                 @default(0)
  color2         Int                 @default(0)
  paintjob       Int?
  modComponents  String?             @map("mod_components") @db.VarChar(255)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(6)
  sysUser        SysUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          VehiclePresetItem[]
  vehicles       UserVehicle[]

  @@unique([userId, modelId, index])
  @@index([userId])
  @@index([modelId])
  @@index([deletedAt])
  @@map("vehicle_preset")
}

model VehiclePresetItem {
  id        String          @id @default(uuid()) @db.Uuid
  presetId  String          @map("preset_id") @db.Uuid
  attireId  String          @map("attire_id") @db.Uuid
  slotId    Int             @map("slot_id")
  x         Decimal         @db.Decimal(18, 6)
  y         Decimal         @db.Decimal(18, 6)
  z         Decimal         @db.Decimal(18, 6)
  rX        Decimal         @map("r_x") @db.Decimal(18, 6)
  rY        Decimal         @map("r_y") @db.Decimal(18, 6)
  rZ        Decimal         @map("r_z") @db.Decimal(18, 6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  preset    VehiclePreset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  attire    Attire          @relation(fields: [attireId], references: [id], onDelete: Cascade)

  @@unique([presetId, slotId])
  @@index([presetId])
  @@index([attireId])
  @@map("vehicle_preset_item")
}

model SpawnPoint {
  id        String   @id @default(uuid()) @db.Uuid
  index     Int      @unique
  x         Decimal  @db.Decimal(18, 6)
  y         Decimal  @db.Decimal(18, 6)
  z         Decimal  @db.Decimal(18, 6)
  angle     Decimal  @db.Decimal(18, 6)
  description String? @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("spawn_point")
}

/**
 * 赛车回放索引（元数据存 DB，录像数据本体存文件 scriptfiles/recordings/）。
 * 玩家 uid 稳定，其余展示信息（玩家名/赛道名/爱车模型/名次）在录制结束时
 * 快照落库——这些字段可能随时间变化（改名/删赛道/换车），快照保证回放列表
 * 永远显示录制当时的信息。
 */
model Replay {
  id             String   @id @default(uuid()) @db.Uuid
  type           String   @db.VarChar(16) // race | ghost
  userId         String   @map("user_id") @db.Uuid // 录制者 uid（稳定）
  recorderName   String   @map("recorder_name") @db.VarChar(255) // 快照：录制时玩家名
  raceId         String?  @map("race_id") @db.Uuid // 比赛回放关联赛道
  raceName       String?  @map("race_name") @db.VarChar(255) // 快照：赛道名（赛道可能被改名/删除）
  vehicleModelId Int      @map("vehicle_model_id") // 快照：爱车模型
  fileName       String   @map("file_name") @db.VarChar(255) // 录像文件相对路径（数据本体）
  durationMs     Int      @map("duration_ms")
  frameCount     Int      @map("frame_count")
  fileSize       Int      @map("file_size")
  rank           Int? // 比赛回放：名次快照（未完成/中途退出为 null）
  finished       Boolean? // 比赛回放：是否完成
  // 比赛房间 id（比赛服务端递增不复用，本场唯一）：无人完成作废精确匹配本场，
  // 防误删"有人完成的比赛里掉线玩家的保留段"（那部分 rank 同样为 null）。
  // 非比赛录制（ghost）为 null。
  raceRoomId     Int?    @map("race_room_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  sysUser        SysUser  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([raceRoomId])
  @@index([deletedAt])
  @@map("replay")
}
